{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/out",
			"!**/build",
			"!**/.turbo",
			"!**/*.tsbuildinfo",
			"!apps/desktop/resources",
			"!pnpm-lock.yaml",
			"!**/tsconfig*.json"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off"
			},
			"a11y": {
				"useHtmlLang": "warn",
				"noLabelWithoutControl": {
					"level": "error",
					"options": {
						"inputComponents": ["Input"]
					}
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["apps/desktop/src/renderer/src/components/ui/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noArrayIndexKey": "off",
						"noDocumentCookie": "off"
					},
					"a11y": {
						"useKeyWithClickEvents": "off",
						"noStaticElementInteractions": "off",
						"useSemanticElements": "off"
					},
					"correctness": {
						"useUniqueElementIds": "off",
						"useExhaustiveDependencies": "off"
					}
				}
			}
		}
	]
}
